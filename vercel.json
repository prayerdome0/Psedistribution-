{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/products",
      "destination": "/products.html"
    },
    {
      "source": "/products/:path*",
      "destination": "/products.html"
    },
    {
      "source": "/product",
      "destination": "/product-detail.html"
    },
    {
      "source": "/product/:path*",
      "destination": "/product-detail.html"
    },
    {
      "source": "/product-detail",
      "destination": "/product-detail.html"
    },
    {
      "source": "/cart",
      "destination": "/cart.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/admin-dashboard",
      "destination": "/admin-dashboard.html"
    },
    {
      "source": "/admin",
      "destination": "/admin-dashboard.html"
    },
    {
      "source": "/seller-dashboard",
      "destination": "/seller-dashboard.html"
    },
    {
      "source": "/seller",
      "destination": "/seller-dashboard.html"
    },
    {
      "source": "/buyer-dashboard",
      "destination": "/buyer-dashboard.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/help-center",
      "destination": "/help-center.html"
    },
    {
      "source": "/help",
      "destination": "/help-center.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/track-order",
      "destination": "/track-order.html"
    },
    {
      "source": "/track-order/:path*",
      "destination": "/track-order.html"
    },
    {
      "source": "/become-seller",
      "destination": "/become-seller.html"
    },
    {
      "source": "/order-success",
      "destination": "/order-success.html"
    },
    {
      "source": "/order-success/:path*",
      "destination": "/order-success.html"
    },
    {
      "source": "/order-sucess",
      "destination": "/order-success.html"
    },
    {
      "source": "/wishlist",
      "destination": "/wishlist.html"
    },
    {
      "source": "/chat",
      "destination": "/chat.html"
    },
    {
      "source": "/chat/:path*",
      "destination": "/chat.html"
    },
    {
      "source": "/rfq",
      "destination": "/rfq.html"
    },
    {
      "source": "/rfq/:path*",
      "destination": "/rfq.html"
    },
    {
      "source": "/supplier-verification",
      "destination": "/supplier-verification.html"
    },
    {
      "source": "/supplier-verification/:path*",
      "destination": "/supplier-verification.html"
    },
    {
      "source": "/about/:path*",
      "destination": "/about.html"
    },
    {
      "source": "/contact/:path*",
      "destination": "/contact.html"
    },
    {
      "source": "/help-center/:path*",
      "destination": "/help-center.html"
    },
    {
      "source": "/cart/:path*",
      "destination": "/cart.html"
    },
    {
      "source": "/checkout/:path*",
      "destination": "/checkout.html"
    },
    {
      "source": "/wishlist/:path*",
      "destination": "/wishlist.html"
    },
    {
      "source": "/login/:path*",
      "destination": "/login.html"
    },
    {
      "source": "/register/:path*",
      "destination": "/register.html"
    },
    {
      "source": "/account/:path*",
      "destination": "/account.html"
    },
    {
      "source": "/become-seller/:path*",
      "destination": "/become-seller.html"
    },
    {
      "source": "/privacy/:path*",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms/:path*",
      "destination": "/terms.html"
    },
    {
      "source": "/buyer-dashboard/:path*",
      "destination": "/buyer-dashboard.html"
    },
    {
      "source": "/seller-dashboard/:path*",
      "destination": "/seller-dashboard.html"
    },
    {
      "source": "/admin-dashboard/:path*",
      "destination": "/admin-dashboard.html"
    },
    {
      "source": "/notifications/:path*",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/order-sucess",
      "destination": "/order-success",
      "permanent": true
    },
    {
      "source": "/order-sucess.html",
      "destination": "/order-success",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(manifest.json|robots.txt|sitemap.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
