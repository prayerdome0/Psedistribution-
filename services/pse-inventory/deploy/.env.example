# PSE Inventory API — deployment environment template.
# NON-SECRET EXAMPLE ONLY. Real values live in the deployment secret store and
# are injected at process start; they are never committed and never reach any
# client bundle. Copy to your deploy environment's secret wiring, then replace
# every `replace-with-...` placeholder.

# --- Required secrets (server exits fail-closed without these) ---------------
# Production mode requires PostgreSQL + Valkey. The local preview harness uses
# generated in-process state instead; never run that mode with more than one API
# replica.
PSE_RUNTIME_MODE=production
PSE_DATABASE_URL=postgresql://pse_storefront:replace-with-storefront-password@postgres:5432/pse_inventory?sslmode=prefer
# Publisher jobs use the separate least-privilege role, never PSE_DATABASE_URL.
PSE_PUBLISHER_DATABASE_URL=postgresql://pse_publisher:replace-with-publisher-password@postgres:5432/pse_inventory?sslmode=prefer
PSE_VALKEY_URL=valkey://:replace-with-valkey-password@valkey:6379/0
# >= 32 bytes of random material, used to sign feed cursors.
PSE_CURSOR_SECRET=replace-with-random-secret-min-32-bytes
# JSON object mapping key ID -> secret (each >= 16 bytes). Supports current +
# previous key IDs during rotation. Example shape (values are placeholders):
# {"k1":"replace-with-hmac-secret-1","k0":"replace-with-hmac-secret-0"}
PSE_REVALIDATION_KEYS_JSON=replace-with-json-key-ring

# --- Non-secret configuration (safe defaults shown) --------------------------
# PSE_PACKET_ROOT=/app/vendor/pse-inventory-packet
# PSE_SNAPSHOT_FILE=/data/current.json
PSE_ALLOWED_ORIGINS=https://pilotsalesdistribution.com
PSE_MAX_LAST_GOOD_AGE_SECONDS=300
PSE_RATE_LIMIT_PER_MINUTE=120

# --- Caddy edge host ----------------------------------------------------------
PSE_SITE_HOST=pilotsalesdistribution.com

# --- PostgreSQL / Valkey bootstrap secrets ------------------------------------
# These are used only by compose.production.yaml or equivalent secret wiring.
POSTGRES_DB=pse_inventory
POSTGRES_USER=pse_admin
POSTGRES_PASSWORD=replace-with-admin-database-password
PSE_PUBLISHER_PASSWORD=replace-with-publisher-password
PSE_STOREFRONT_PASSWORD=replace-with-storefront-password
VALKEY_PASSWORD=replace-with-valkey-password

# --- Test-only wiring (never set in a running service) ------------------------
# Points the pytest suite at a real pinned PostgreSQL for live-DB coverage.
# PSE_TEST_DATABASE_URL=replace-with-test-database-url
