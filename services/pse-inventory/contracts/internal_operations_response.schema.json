{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pilotsalesdistribution.com/schemas/internal_operations_response.schema.json",
  "title": "PSE Internal Operations Response v4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "contractVersion",
    "timestamp"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "degraded",
        "unavailable"
      ]
    },
    "contractVersion": {
      "type": "string",
      "const": "4.0.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "snapshotVersion": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "detail": {
      "type": "string",
      "maxLength": 200
    }
  }
}
