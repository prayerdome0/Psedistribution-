{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pilotsalesdistribution.com/schemas/canonical_inventory_record.schema.json",
  "title": "PSE Private Canonical Inventory Record v4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordVersion",
    "dealId",
    "status",
    "reviewStatus",
    "publishApproved",
    "publishApproval",
    "publishBlockers",
    "source",
    "inventory",
    "privateCommercial",
    "publicProfile",
    "audit"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "4.0.0"
    },
    "recordVersion": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "dealId": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]{5,79}$"
    },
    "canonicalProductId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "available",
        "limited",
        "hold",
        "reserved",
        "sold",
        "withdrawn",
        "recall-hold",
        "archived"
      ]
    },
    "reviewStatus": {
      "type": "string",
      "enum": [
        "ready",
        "needs-review",
        "blocked",
        "pending"
      ]
    },
    "publishApproved": {
      "type": "boolean"
    },
    "publishApproval": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "approvedBy",
        "approvedAt",
        "approvalVersion"
      ],
      "properties": {
        "approvedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "approvalVersion": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "publishBlockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRecordIds",
        "sourceHashes",
        "sourceVersion",
        "lastSourceVerifiedAt",
        "lastAvailabilityConfirmedAt",
        "availabilityExpiresAt",
        "proofEvidenceIds"
      ],
      "properties": {
        "sourceRecordIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "sourceHashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "sourceVersion": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "lastSourceVerifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastAvailabilityConfirmedAt": {
          "type": "string",
          "format": "date-time"
        },
        "availabilityExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "proofEvidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "onHandUnits",
        "reservedUnits",
        "availableToSell"
      ],
      "properties": {
        "onHandUnits": {
          "type": "integer",
          "minimum": 0
        },
        "reservedUnits": {
          "type": "integer",
          "minimum": 0
        },
        "availableToSell": {
          "type": "integer",
          "minimum": 0
        },
        "casesAvailable": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unitsPerCase": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "supplier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "supplierSku": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "contactReference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "privateCommercial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisitionCostPerUnit",
        "internalSellFloorPerUnit",
        "marketReferencePerUnit",
        "internalNotes",
        "proofLinks"
      ],
      "properties": {
        "acquisitionCostPerUnit": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "internalSellFloorPerUnit": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "marketReferencePerUnit": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "internalNotes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "proofLinks": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "publicProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "termsVersion",
        "slug",
        "title",
        "shortDescription",
        "category",
        "quantityMode",
        "condition",
        "moqUnits",
        "pricingMode",
        "currency",
        "fob",
        "freightTerms",
        "inspectionTerms",
        "returnTerms",
        "imageUrls",
        "rfqEnabled"
      ],
      "properties": {
        "termsVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^<>\\u0000-\\u001F\\u007F]+$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[^<>\\u0000-\\u001F\\u007F]+$"
        },
        "shortDescription": {
          "type": "string",
          "minLength": 10,
          "maxLength": 600,
          "pattern": "^[^<>\\u0000-\\u001F\\u007F]+$"
        },
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^<>\\u0000-\\u001F\\u007F]+$"
        },
        "category": {
          "type": "string",
          "enum": [
            "electronics",
            "apparel",
            "grocery",
            "home-kitchen",
            "beauty-personal-care",
            "health",
            "sports",
            "automotive",
            "baby",
            "office",
            "industrial",
            "books",
            "pets",
            "toys-seasonal",
            "trading-cards",
            "beverages",
            "candy-snacks",
            "mixed-truckload",
            "other"
          ]
        },
        "quantityMode": {
          "type": "string",
          "enum": [
            "exact",
            "range",
            "confirm"
          ]
        },
        "quantityRange": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum",
            "maximum"
          ],
          "properties": {
            "minimum": {
              "type": "integer",
              "minimum": 1
            },
            "maximum": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "moqUnits": {
          "type": "integer",
          "minimum": 1
        },
        "moqCases": {
          "type": "integer",
          "minimum": 1
        },
        "pricingMode": {
          "type": "string",
          "enum": [
            "public",
            "rfq"
          ]
        },
        "publicUnitPrice": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "publicCasePrice": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "publicLotPrice": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "type": "string",
          "const": "USD"
        },
        "condition": {
          "type": "string",
          "enum": [
            "new",
            "new-retail-box",
            "shelf-pull",
            "overstock",
            "closeout",
            "mixed",
            "other"
          ]
        },
        "upc": {
          "type": "string",
          "pattern": "^(?:[0-9]{8}|[0-9]{12}|[0-9]{13}|[0-9]{14})$"
        },
        "bestBy": {
          "type": "string",
          "format": "date"
        },
        "fob": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "pattern": "^[^<>\\u0000-\\u001F\\u007F]+$"
        },
        "freightTerms": {
          "type": "string",
          "enum": [
            "freight-extra",
            "freight-included",
            "pickup-only",
            "quote-required"
          ]
        },
        "inspectionTerms": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500,
          "pattern": "^[^<>\\u0000-\\u001F\\u007F]+$"
        },
        "returnTerms": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500,
          "pattern": "^[^<>\\u0000-\\u001F\\u007F]+$"
        },
        "imageUrls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^\\s]+$"
          }
        },
        "specSheetUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s]+$"
        },
        "rfqEnabled": {
          "type": "boolean",
          "const": true
        },
        "seo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metaTitle": {
              "type": "string",
              "minLength": 1,
              "maxLength": 70,
              "pattern": "^[^<>\\u0000-\\u001F\\u007F]+$"
            },
            "metaDescription": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180,
              "pattern": "^[^<>\\u0000-\\u001F\\u007F]+$"
            }
          }
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "quantityMode": {
                  "const": "exact"
                }
              },
              "required": [
                "quantityMode"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "quantityRange"
                    ]
                  }
                ]
              }
            },
            {
              "properties": {
                "quantityMode": {
                  "const": "range"
                }
              },
              "required": [
                "quantityMode",
                "quantityRange"
              ]
            },
            {
              "properties": {
                "quantityMode": {
                  "const": "confirm"
                },
                "pricingMode": {
                  "const": "rfq"
                }
              },
              "required": [
                "quantityMode",
                "pricingMode"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "quantityRange"
                    ]
                  },
                  {
                    "required": [
                      "publicUnitPrice"
                    ]
                  },
                  {
                    "required": [
                      "publicCasePrice"
                    ]
                  },
                  {
                    "required": [
                      "publicLotPrice"
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "pricingMode": {
                  "const": "rfq"
                }
              },
              "required": [
                "pricingMode"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "publicUnitPrice"
                    ]
                  },
                  {
                    "required": [
                      "publicCasePrice"
                    ]
                  },
                  {
                    "required": [
                      "publicLotPrice"
                    ]
                  }
                ]
              }
            },
            {
              "properties": {
                "pricingMode": {
                  "const": "public"
                }
              },
              "required": [
                "pricingMode",
                "publicUnitPrice"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "publicCasePrice"
                    ]
                  },
                  {
                    "required": [
                      "publicLotPrice"
                    ]
                  }
                ]
              }
            },
            {
              "properties": {
                "pricingMode": {
                  "const": "public"
                }
              },
              "required": [
                "pricingMode",
                "publicCasePrice",
                "casesAvailable",
                "unitsPerCase"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "publicUnitPrice"
                    ]
                  },
                  {
                    "required": [
                      "publicLotPrice"
                    ]
                  }
                ]
              }
            },
            {
              "properties": {
                "pricingMode": {
                  "const": "public"
                }
              },
              "required": [
                "pricingMode",
                "publicLotPrice"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "publicUnitPrice"
                    ]
                  },
                  {
                    "required": [
                      "publicCasePrice"
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "reviewer",
        "recordUpdatedAt"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "recordUpdatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastPublishedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "lastApiSyncAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "lastSiteRevalidatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publishApproved": {
            "const": true
          }
        },
        "required": [
          "publishApproved"
        ]
      },
      "then": {
        "required": [
          "publishApproval"
        ],
        "properties": {
          "publishApproval": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publishApproved": {
            "const": false
          }
        },
        "required": [
          "publishApproved"
        ]
      },
      "then": {
        "properties": {
          "publishApproval": {
            "type": "null"
          }
        }
      }
    }
  ]
}
