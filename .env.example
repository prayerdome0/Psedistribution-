# ─────────────────────────────────────────────────────────────────────────────
# Pilot Sales Distribution — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# This file is a TEMPLATE. Copy to `.env`, `.env.local`, or your hosting
# provider's secret store and replace every `replace-with-…` placeholder with
# a real value. NEVER commit the real `.env` (it's in .gitignore).
#
# Variables are grouped by the service that uses them:
#   [1] Frontend (Vercel project env / .env.local)
#   [2] Inventory API (production server / container env)
#   [3] Email (Resend / FormSubmit)
#   [4] External integrations (operator-supplied accounts)
#   [5] Observability & backups
#
# The frontend values are baked into the site at build time (Vite / Vercel
# build step). The inventory API values are read at process start (see
# services/pse-inventory/pse_inventory/server.py).
# ─────────────────────────────────────────────────────────────────────────────

# ════════════════════════════════════════════════════════════════════════════
# [1] FRONTEND (Vercel project → Settings → Environment Variables)
# ════════════════════════════════════════════════════════════════════════════

# Firebase web SDK config — visible in browser, not a secret.
# Find these in Firebase Console → Project Settings → General → Your apps.
PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=replace-with-project-id
PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-project.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
PUBLIC_FIREBASE_APP_ID=replace-with-app-id

# Public inventory API base URL. In production: your FastAPI service behind
# a CDN. In dev: http://localhost:8080
PUBLIC_INVENTORY_API_BASE=https://inventory.pilotsalesdistribution.com

# Resend (transactional email) — OPTIONAL. The site falls back to keyless
# FormSubmit + mailto when this is absent. The form field is exposed via
# <meta name="resend-key"> or window.PSE_CONFIG.resendKey for runtime override.
PUBLIC_RESEND_KEY=

# Google reCAPTCHA v3 (bot protection on RFQ + register) — OPTIONAL.
PUBLIC_RECAPTCHA_SITE_KEY=

# Sentry public DSN (client-side error reporting) — OPTIONAL.
PUBLIC_SENTRY_DSN=

# Analytics — OPTIONAL
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_META_PIXEL_ID=

# ════════════════════════════════════════════════════════════════════════════
# [2] INVENTORY API (services/pse-inventory — production server / k8s)
# ════════════════════════════════════════════════════════════════════════════

# Required. Path to the active public snapshot. Mount /data as a volume in
# production. The publisher (publish_snapshot.py) atomically promotes to this
# file and archives the prior version under data/history/.
PSE_SNAPSHOT_FILE=/data/current.json

# Required. Path to the vendored contract packet. Defaults to the
# vendor/pse-inventory-packet directory in this repo.
PSE_PACKET_ROOT=/app/vendor/pse-inventory-packet

# Required. Min 32 bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PSE_CURSOR_SECRET=replace-with-32+-byte-random-string

# Required. JSON object: {"keyId1": "secret1", "keyId2": "secret2"}.
# Each secret must be >= 16 bytes. Used for HMAC-signed revalidate calls.
# Generate with:
#   python -c "import secrets, json; print(json.dumps({'prod-2026-08': secrets.token_urlsafe(32)}))"
PSE_REVALIDATION_KEYS_JSON=replace-with-json-object

# Required. PostgreSQL connection string. Use the connection-pooler URL
# (e.g. Supabase / Neon / RDS Proxy) for serverless deployments.
PSE_DATABASE_URL=postgres://user:pass@host:5432/pse_inventory

# Required. Valkey (Redis-compatible) URL. Used for shared rate-limit +
# replay state across replicas.
PSE_VALKEY_URL=redis://default:pass@host:6379/0

# Optional. Comma-separated CORS allowlist. Defaults to the production
# origin. Include localhost / preview origins only for staging.
PSE_ALLOWED_ORIGINS=https://pilotsalesdistribution.com,https://www.pilotsalesdistribution.com

# Optional. How long a stale "last known good" snapshot may still be served
# after the active snapshot becomes unavailable. Default 300s.
PSE_MAX_LAST_GOOD_AGE_SECONDS=300

# Optional. Per-IP rate limit (req/min) on the public list endpoint. Default 120.
PSE_RATE_LIMIT_PER_MINUTE=120

# Optional. "single" (default) or "production". Production mode enforces
# PostgreSQL + Valkey at startup and fails closed.
PSE_RUNTIME_MODE=production

# ════════════════════════════════════════════════════════════════════════════
# [3] EMAIL
# ════════════════════════════════════════════════════════════════════════════

# Resend (https://resend.com/api-keys). Used by email.js when present.
# If empty, the site falls back to the keyless FormSubmit + mailto path
# (no signup required, lower deliverability, no attachments).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@pilotsalesdistribution.com
RESEND_FROM_NAME="Pilot Sales Distribution"
ADMIN_NOTIFICATION_EMAIL=admin@pilotsalesdistribution.com

# FormSubmit — keyless email fallback. Set this to the address that should
# receive contact-form + fallback submissions. To activate, visit
# https://formsubmit.co/<email> once from the receiving mailbox.
FORMSUBMIT_TO=admin@pilotsalesdistribution.com

# ════════════════════════════════════════════════════════════════════════════
# [4] EXTERNAL INTEGRATIONS (operator-supplied accounts)
# ════════════════════════════════════════════════════════════════════════════
# All values in this section are OPTIONAL. When empty, the corresponding
# feature is gracefully disabled in the UI with an "operator setup required"
# notice. NEVER commit real keys here.

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Mobile Money (Zambia — operator must integrate per provider docs)
MTN_MOMO_API_USER_ID=
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_ENVIRONMENT=sandbox
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=

# WhatsApp Business API (https://developers.facebook.com/docs/whatsapp)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ERP integration (SAP / Oracle / NetSuite / Odoo). Webhook target for
# inventory + order sync. Secret used to HMAC sign payloads to the ERP.
ERP_WEBHOOK_URL=
ERP_WEBHOOK_SECRET=

# Accounting (Xero / QuickBooks)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=

# ════════════════════════════════════════════════════════════════════════════
# [5] OBSERVABILITY & BACKUPS
# ════════════════════════════════════════════════════════════════════════════

# Sentry (https://sentry.io) — frontend DSN (public) + backend DSN (secret).
# If empty, the app uses console logging only.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# Healthcheck ping URLs (optional). Used by the operator to monitor uptime.
# UptimeRobot / BetterStack / Healthchecks.io will POST to these.
HEALTHCHECK_INVENTORY_URL=
HEALTHCHECK_SITE_URL=

# Daily snapshot backups (services/pse-inventory/data/backups/).
# Mounted to /backups on the inventory server. Schedule via cron (see
# scripts/pse-inventory-backup.sh) or the host's scheduler.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_ENCRYPTION_PASSPHRASE=replace-with-32+-byte-passphrase

# SMTP for outbound notifications (alternative to Resend).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
